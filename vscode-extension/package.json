{
  "name": "cm-language",
  "displayName": "Cm Language Support",
  "description": "Syntax highlighting and language support for the Cm programming language",
  "version": "0.16.2",
  "publisher": "cm-lang",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "cm",
    "programming language",
    "syntax highlighting",
    "systems programming"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shadowlink0122/Cm"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "scripts": {
    "compile": "tsc -p ./",
    "build:grammar": "tsc -p ./ && node out/src/grammar/build.js",
    "verify:grammar": "tsc -p ./ && node out/src/grammar/build.js --check",
    "test": "tsc -p ./ && node --test out/src/test/*.test.js",
    "update-version": "tsc -p ./ && node out/scripts/update-version.js",
    "verify-version": "tsc -p ./ && node out/scripts/verify-version.js",
    "prepackage": "npm run verify-version && npm run verify:grammar",
    "package": "pnpm exec vsce package --allow-missing-repository --skip-license",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'scripts/**/*.ts' 'src/**/*.ts'",
    "format:check": "prettier --check 'scripts/**/*.ts' 'src/**/*.ts'"
  },
  "contributes": {
    "languages": [
      {
        "id": "cm",
        "aliases": [
          "Cm",
          "cm"
        ],
        "extensions": [
          ".cm"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/icon.svg",
          "dark": "./images/icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "cm",
        "scopeName": "source.cm",
        "path": "./syntaxes/cm.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "cm-icons",
        "label": "Cm Icons",
        "path": "./iconTheme.json"
      }
    ],
    "configuration": {
      "title": "Cm",
      "properties": {
        "cm.dimInactiveCode": {
          "type": "boolean",
          "default": true,
          "description": "明らかに無効なスコープ（未定義シンボルの#ifdef、リテラルfalseのif等）をトーンダウン表示する"
        },
        "cm.activeDefines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "エディタ上で定義済みとみなすシンボル（例: [\"TEST\"]）。#ifdef判定に使用"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "@eslint/js": "^9.0.0",
    "@types/vscode": "^1.80.0"
  },
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguage:cm"
  ]
}
