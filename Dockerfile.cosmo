# Cosmo Linux向け Cmコンパイラ ビルド
# 
# 使い方:
#   cd Cm && docker build -f Dockerfile.cosmo --platform linux/amd64 -t cm-cosmo .
#   # バイナリ+共有ライブラリ取り出し
#   docker run --rm cm-cosmo tar cf - /opt/cm | tar xf - -C ../cosmo-linux/rootfs/packages/

FROM --platform=linux/amd64 ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# ビルドツール + LLVM 17
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    gcc-13 \
    g++-13 \
    clang-17 \
    llvm-17-dev \
    lld-17 \
    zlib1g-dev \
    libzstd-dev \
    libtinfo-dev \
    file \
    && rm -rf /var/lib/apt/lists/*

# コンパイラ設定
RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-13 100 \
    && update-alternatives --install /usr/bin/clang clang /usr/bin/clang-17 100 \
    && update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-17 100 \
    && update-alternatives --install /usr/bin/llvm-config llvm-config /usr/bin/llvm-config-17 100

WORKDIR /workspace

# ソースコピー
COPY . .

# ビルド (LLVM共有ライブラリ + C++/C標準ライブラリ静的)
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
    -DCM_USE_LLVM=ON \
    -DCM_TARGET_ARCH=x86_64 \
    -DCMAKE_C_COMPILER=/usr/bin/gcc-13 \
    -DCMAKE_CXX_COMPILER=/usr/bin/g++-13 \
    -DCMAKE_CXX_FLAGS="-DCM_NO_ARM_TARGET" \
    -DCMAKE_EXE_LINKER_FLAGS="-static-libgcc -static-libstdc++" \
    && cmake --build build -j$(nproc) \
    && strip cm \
    && echo "=== cm binary ===" \
    && file cm \
    && ls -lh cm \
    && ldd cm

# パッケージング: cmバイナリ + 必要な共有ライブラリ
RUN mkdir -p /opt/cm/lib \
    && cp cm /opt/cm/cm \
    && for lib in $(ldd cm | grep -oP '/\S+\.so[\.\d]*'); do \
    cp "$lib" /opt/cm/lib/ 2>/dev/null || true; \
    done \
    && echo "=== パッケージ内容 ===" \
    && ls -lh /opt/cm/ \
    && ls -lh /opt/cm/lib/

CMD ["./cm", "version"]
