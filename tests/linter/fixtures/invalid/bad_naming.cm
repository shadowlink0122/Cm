// テスト: 命名規則違反 (L001 naming-convention。check/lint --strict で検出)
// 期待: 構造体名・フィールド名・関数名・変数名・定数名の各違反が警告される

// L001違反: 構造体名がsnake_case（PascalCaseであるべき）
struct bad_struct {
    int id;
}

// L001違反: フィールド名がcamelCase（snake_caseであるべき）
struct Holder {
    int badField;
}

// L001違反: 関数名がPascalCase（snake_caseであるべき）
int CalculateSum(int a, int b) {
    return a + b;
}

// L001違反: グローバル定数名がsnake_case（UPPER_SNAKE_CASEであるべき）
const int bad_constant = 100;

int main() {
    // L001違反: 変数名がcamelCase（snake_caseであるべき）
    int camelCase = 10;

    int result = camelCase + bad_constant + CalculateSum(1, 2);
    println(result);
    return 0;
}
