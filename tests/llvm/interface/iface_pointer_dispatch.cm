// interfaceポインタの動的ディスパッチ:
// Shape* は実装オブジェクトを直接指すfat pointerとして表現され、
// 付け替えによって実装が切り替わることを検証
import std::io::println;

interface Shape { int area(); }

struct Sq { int s; }
struct Rect { int w; int h; }

impl Sq for Shape { int area() { return self.s * self.s; } }
impl Rect for Shape { int area() { return self.w * self.h; } }

int main() {
    Sq sq = Sq { s: 5 };
    Rect rc = Rect { w: 3, h: 4 };

    Shape* p = &sq;
    int a1 = (*p).area();

    // ポインタの付け替え（vtableも切り替わる）
    p = &rc;
    int a2 = (*p).area();

    println("ptr dispatch: {a1} {a2}");

    // interface値のアドレス経由
    Shape sh = sq;
    Shape* q = &sh;
    int a3 = (*q).area();
    println("via value: {a3}");
    return 0;
}
