// m入力制約テスト - メモリから読み込み
import std::io::println;

int main() {
    #ifdef __x86_64__
        // === テスト1: mでメモリから読み込み ===
        const int mem_val = 42;
        const int result = 0;
        __asm__("movl ${m:mem_val}, ${=r:result}");
        println(result);  // 42

        // === テスト2: 別の値をメモリから読み込み ===
        const int src = 100;
        const int dst = 0;
        __asm__("movl ${m:src}, ${=r:dst}");
        println(dst);  // 100

    #else
        // ARM64版
        // === テスト1: mでメモリから読み込み ===
        const int mem_val = 42;
        const int result = 0;
        __asm__("ldr ${=r:result}, ${m:mem_val}");
        println(result);  // 42

        // === テスト2: 別の値をメモリから読み込み ===
        const int src = 100;
        const int dst = 0;
        __asm__("ldr ${=r:dst}, ${m:src}");
        println(dst);  // 100

    #end
    return 0;
}
