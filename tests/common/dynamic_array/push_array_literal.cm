// 回帰(X3): 多次元スライスへの配列リテラル直接pushが壊れた要素を格納するバグの検証
import std::io::println;
int main() {
    int[][] xs = [];
    xs.push([1, 2]);
    println("{xs[0][0]} {xs[0].len()}");
    xs.push([]);
    xs[1].push(7);
    println("{xs[1][0]} {xs[1].len()}");
    string[][] rows = [];
    rows.push(["a", "b"]);
    println(rows[0][1]);
    int[] direct = [];
    direct.push(1);
    int[][] ys = [];
    ys.push(direct);
    println(ys[0][0]);
    return 0;
}
