// ファイルI/Oのテスト（std::fs）
// 基本API（bool返却）とResult API（Rust準拠）の両方を検証する
// 注: `import std::fs; fs::write_file(...)` の名前空間形式はモジュールシステム全体で未対応のため選択的importを使用する
import std::io::println;
import std::io::print;
import std::fs::{write_file, exists, read_file, append_file, remove, read_to_string, remove_file};

int main() {
    const string path = "test_io.txt";
    const string content = "Hello, Cm File I/O!\nLine 2: Testing write/read.";

    println("=== File I/O Test ===");

    // 1. Write
    print("Writing to file: ");
    if (write_file(path, content)) {
        println("SUCCESS");
    } else {
        println("FAILED");
        return 1;
    }

    // 2. Exists
    print("Checking exists: ");
    if (exists(path)) {
        println("SUCCESS");
    } else {
        println("FAILED");
    }

    // 3. Read
    print("Reading from file: ");
    const string read_back = read_file(path);
    if (read_back == content) {
        println("SUCCESS");
    } else {
        println("FAILED");
    }

    // 4. Append
    print("Appending to file: ");
    const string extra = "\nLine 3: Appended.";
    if (append_file(path, extra)) {
        println("SUCCESS");
    } else {
        println("FAILED");
    }

    // 5. Read all back
    print("Verifying append: ");
    const string final_content = read_file(path);
    if (final_content == content + extra) {
        println("SUCCESS");
    } else {
        println("FAILED");
    }

    // 6. Result API: read_to_string（Rustのfs::read_to_string相当）
    print("read_to_string: ");
    Result<string, string> r = read_to_string(path);
    if (r.is_ok()) {
        println("SUCCESS");
    } else {
        println("FAILED");
    }

    // 7. Result API: 存在しないファイルはErr
    print("read_to_string missing: ");
    const Result<string, string> missing = read_to_string("no_such_file.txt");
    match (missing) {
        Result::Ok(v) => println("FAILED"),
        Result::Err(e) => println("SUCCESS ({e})"),
    }

    // 8. Result API: remove_file
    print("remove_file: ");
    Result<bool, string> rm = remove_file(path);
    if (rm.is_ok()) {
        println("SUCCESS");
    } else {
        println("FAILED");
    }

    println("=== Test Completed ===");
    return 0;
}
