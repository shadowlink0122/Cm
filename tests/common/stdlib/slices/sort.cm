// std::slices: ヒープソートの正しさ（逆順・重複・既ソート・空・1要素・比較関数・double・string）
import std::io::println;
import std::slices::*;

int main() {
    int[] a = [5, 1, 4, 1, 3, 9, 2, 6, 5, 3];
    sort(a);
    println("{a[0]} {a[1]} {a[2]} {a[3]} {a[4]} {a[5]} {a[6]} {a[7]} {a[8]} {a[9]}");

    int[] e = [];
    sort(e);
    int[] one = [42];
    sort(one);
    int[] sorted = [1, 2, 3];
    sort(sorted);
    println("e={e.len()} one={one[0]} s={sorted[0]}{sorted[1]}{sorted[2]}");

    sort_by(a, (int x, int y) => y - x);
    println("desc {a[0]} {a[9]}");

    double[] d = [2.5, 0.5, 1.5];
    sort(d);
    println("{d[0]} {d[1]} {d[2]}");

    string[] s = ["banana", "apple", "cherry"];
    sort(s);
    println("{s[0]} {s[1]} {s[2]}");
    return 0;
}
