// パフォーマンススモーク: 20000要素の逆順ソートがタイムアウト内に完了する（挿入ソートO(n²)では約2億比較で退化する規模）
import std::io::println;
import std::slices::*;

int main() {
    const int n = 20000;
    int[] xs = [];
    for (int i = 0; i < n; i++) {
        xs.push(n - i);
    }
    sort(xs);
    bool ok = true;
    for (int i = 0; i < n; i++) {
        if (xs[i] != i + 1) {
            ok = false;
        }
    }
    println("sorted={ok} first={xs[0]} last={xs[n - 1]}");
    return 0;
}
