import std::io::println;
// 構造体ポインタテスト

struct Point {
    int x;
    int y;
}

int main() {
    Point p;
    p.x = 10;
    p.y = 20;

    Point* ptr = &p;

    // ポインタ経由でメンバーにアクセス
    const Point deref = *ptr;
    const int px = deref.x;
    const int py = deref.y;
    println("(*ptr).x = {px}");
    println("(*ptr).y = {py}");

    // ポインタ経由で変更
    Point tmp;
    tmp.x = 100;
    tmp.y = 200;
    *ptr = tmp;

    const int newx = p.x;
    const int newy = p.y;
    println("after modify: p.x = {newx}");
    println("after modify: p.y = {newy}");

    return 0;
}
