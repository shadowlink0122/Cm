// std::collections::HashMap<K, V>テスト（getはOption返し、既存キーの読み出しはget_orを使用）
// import std::collections::hashmap を使用
// HashMap<K, V>は両方がジェネリック
import std::io::println;
import std::collections::hashmap::*;

int main() {
    println("=== HashMap<K, V> Test ===");

    // 1. HashMap<int, int> テスト
    println("1. HashMap<int, int>:");
    HashMap<int, int> m1();

    m1.insert(1, 100);
    m1.insert(2, 200);
    m1.insert(3, 300);
    int len = m1.len();
    println("  insert 3 items: len={len}");

    const int v1 = m1.get_or(1, 0);
    int v2 = m1.get_or(2, 0);
    const int v3 = m1.get_or(3, 0);
    println("  get: 1->{v1}, 2->{v2}, 3->{v3}");

    bool has1 = m1.contains(1);
    const bool has99 = m1.contains(99);
    println("  contains: 1={has1}, 99={has99}");

    m1.insert(2, 999);
    v2 = m1.get_or(2, 0);
    println("  update 2->999: get(2)={v2}");

    m1.remove(1);
    has1 = m1.contains(1);
    len = m1.len();
    println("  remove(1): contains={has1}, len={len}");

    m1.clear();
    len = m1.len();
    println("  clear: len={len}");

    m1.insert(10, 1000);
    m1.insert(20, 2000);
    len = m1.len();
    const int v10 = m1.get_or(10, 0);
    const int v20 = m1.get_or(20, 0);
    println("  reuse: len={len}, 10->{v10}, 20->{v20}");

    // デストラクタが自動的に呼ばれる
    println("  destructor called");

    // 2. HashMap<int, long> テスト
    println("2. HashMap<int, long>:");
    HashMap<int, long> m2();

    m2.insert(1, 10000 as long);
    m2.insert(2, 20000 as long);
    len = m2.len();
    println("  insert 2 items: len={len}");

    const long lv1 = m2.get_or(1, 0 as long);
    const long lv2 = m2.get_or(2, 0 as long);
    println("  get: 1->{lv1}, 2->{lv2}");

    // デストラクタが自動的に呼ばれる
    println("  destructor called");

    // 3. HashMap<int, bool> テスト
    println("3. HashMap<int, bool>:");
    HashMap<int, bool> m3();

    m3.insert(1, true);
    m3.insert(2, false);
    m3.insert(3, true);
    len = m3.len();
    println("  insert 3 items: len={len}");

    const bool b1 = m3.get_or(1, false);
    const bool b2 = m3.get_or(2, false);
    const bool b3 = m3.get_or(3, false);
    println("  get: 1->{b1}, 2->{b2}, 3->{b3}");

    // デストラクタが自動的に呼ばれる
    println("  destructor called");

    println("=== PASS ===");
    return 0;
}
