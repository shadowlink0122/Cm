import ../modules_alias_src/a::{compute};
import ../modules_alias_src/b::{compute as compute_b};
import std::io::println;

// M2回帰: 同名シンボルの衝突はエイリアスで回避でき、両方の実装を呼び分けられることを検証する。
// あわせて (1) ブレース内の as がモジュールエイリアスと誤解釈されない
// (2) 展開断片内の識別子改名（自己参照含む）が機能する、のパース/展開の回帰を固定する。

int main() {
    println(compute(10));
    println(compute_b(10));
    return 0;
}
