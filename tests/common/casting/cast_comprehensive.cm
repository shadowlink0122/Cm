// Cast（型変換）網羅テスト
import std::io::println;

int main() {
    println("=== Cast Comprehensive Test ===");

    // ===========================================
    // 1. 整数型間のキャスト
    // ===========================================
    println("1. Integer type casts:");

    const int i = 42;
    const long l = i as long;
    const short s = i as short;
    const tiny t = i as tiny;
    println("  int 42 -> long: {l}");
    println("  int 42 -> short: {s}");
    println("  int 42 -> tiny: {t}");

    const long big = 1000000;
    const int from_long = big as int;
    println("  long 1000000 -> int: {from_long}");

    // ===========================================
    // 2. 浮動小数点 <-> 整数
    // ===========================================
    println("2. Float/Int casts:");

    const double d = 3.14159;
    const int d_to_i = d as int;
    println("  double 3.14159 -> int: {d_to_i}");

    const float f = 2.5;
    const int f_to_i = f as int;
    println("  float 2.5 -> int: {f_to_i}");

    const int i2 = 7;
    const double i_to_d = i2 as double;
    const float i_to_f = i2 as float;
    println("  int 7 -> double: {i_to_d}");
    println("  int 7 -> float: {i_to_f}");

    // float <-> double
    const double d2 = 1.23456789;
    const float d_to_f = d2 as float;
    println("  double 1.23456789 -> float: {d_to_f}");

    const float f2 = 9.87;
    const double f_to_d = f2 as double;
    println("  float 9.87 -> double: {f_to_d}");

    // ===========================================
    // 3. bool <-> int
    // ===========================================
    println("3. Bool/Int casts:");

    const bool btrue = true;
    const bool bfalse = false;
    const int btrue_i = btrue as int;
    const int bfalse_i = bfalse as int;
    println("  true -> int: {btrue_i}");
    println("  false -> int: {bfalse_i}");

    const int one = 1;
    const int zero = 0;
    const bool one_b = one as bool;
    const bool zero_b = zero as bool;
    println("  1 -> bool: {one_b}");
    println("  0 -> bool: {zero_b}");

    // ===========================================
    // 4. ポインタキャスト
    // ===========================================
    println("4. Pointer casts:");

    int val1 = 111;
    const int val2 = 222;
    const int val3 = 333;

    int* ip = &val1;
    void* vp = ip as void*;
    int* ip2 = vp as int*;
    const int val = *ip2;
    println("  int* -> void* -> int*: {val}");

    const long addr = ip as long;
    const bool addr_nonzero = addr != 0;
    println("  int* -> long (address): nonzero={addr_nonzero}");

    // ===========================================
    // 5. 符号なし整数
    // ===========================================
    println("5. Unsigned casts:");

    const uint ui = 100 as uint;
    const int ui_to_i = ui as int;
    println("  uint 100 -> int: {ui_to_i}");

    const int neg = 0 - 1;
    const uint neg_to_ui = neg as uint;
    println("  int -1 -> uint: converted");

    // ===========================================
    // 6. char <-> int
    // ===========================================
    println("6. Char/Int casts:");

    const char c = 'A';
    const int c_to_i = c as int;
    println("  'A' -> int: {c_to_i}");

    const int code = 66;
    const char i_to_c = code as char;
    println("  66 -> char: B");

    // ===========================================
    // 7. 連続キャスト
    // ===========================================
    println("7. Chained casts:");

    const double d3 = 99.9;
    const int d3_i = d3 as int;
    const short d3_s = d3_i as short;
    const tiny chain = d3_s as tiny;
    println("  double 99.9 -> int -> short -> tiny: {chain}");

    println("");
    println("=== PASS ===");
    return 0;
}
