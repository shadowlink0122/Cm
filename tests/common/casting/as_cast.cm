// as T キャスト構文のテスト（typeof検証付き）

struct Point {
    int x;
    int y;
}

void main() {
    // int -> double キャスト
    int i = 42;
    const double d = i as double;
    println("int to double: {d}");
    const string ti = typeof(i);
    const string td = typeof(d);
    println("  typeof(i) = {ti}");
    println("  typeof(d) = {td}");

    // double -> int キャスト
    const double pi = 3.14159;
    const int pi_int = pi as int;
    println("double to int: {pi_int}");
    const string tpi = typeof(pi);
    const string tpi_int = typeof(pi_int);
    println("  typeof(pi) = {tpi}");
    println("  typeof(pi_int) = {tpi_int}");

    // bool -> int キャスト
    const bool flag = true;
    const int b = flag as int;
    println("bool to int: {b}");
    const string tflag = typeof(flag);
    const string tb = typeof(b);
    println("  typeof(flag) = {tflag}");
    println("  typeof(b) = {tb}");

    // char -> int キャスト
    const char c = 'A';
    const int c_int = c as int;
    println("char to int: {c_int}");
    const string tc = typeof(c);
    const string tc_int = typeof(c_int);
    println("  typeof(c) = {tc}");
    println("  typeof(c_int) = {tc_int}");

    // 連鎖キャスト
    const double x = 10.5;
    const int y = x as int;
    const double z = y as double;
    println("chain cast: {z}");

    // 構造体の型名
    const Point pt = Point{x: 10, y: 20};
    const string tpt = typeof(pt);
    println("struct type: {tpt}");

    // ポインタの型名
    int* pi_ptr = &i;
    const string tptr = typeof(pi_ptr);
    println("pointer type: {tptr}");

    println("All cast tests passed!");
}
