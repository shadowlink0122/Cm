// 回帰(N3): 文字列switchがLLVM検証エラー・jsでelse落ちになるバグの検証（文字列Eqチェーンへ脱糖）
import std::io::println;
string classify(string s) {
    switch (s) {
        case("alpha") {
            return "a";
        }
        case("beta") {
            return "b";
        }
        case("") {
            return "empty";
        }
        else {
            return "other";
        }
    }
    return "unreachable";
}
int main() {
    println(classify("alpha"));
    println(classify("beta"));
    println(classify(""));
    println(classify("gamma"));
    string b2 = "be" + "ta";
    println(classify(b2));
    return 0;
}
