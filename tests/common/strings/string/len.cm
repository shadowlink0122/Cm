import std::io::println;
// 文字列の.len()メソッドテスト

int main() {
    const string s = "Hello";
    const uint len = s.len();
    println(len);
    // 5

    const string empty = "";
    println(empty.len());
    // 0

    const string long_str = "Hello, World!";
    println(long_str.len());
    // 13

    // .size() と .length() エイリアス
    println(s.size());
    // 5
    println(s.length());
    // 5

    return 0;
}
