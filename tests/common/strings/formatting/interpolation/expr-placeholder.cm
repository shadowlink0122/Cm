// 補間プレースホルダに任意の式を書ける（局所処理調査D）:
// 先頭が識別子でない式（数値・配列リテラル・文字列リテラル）や三項演算子も、本物の式パーサで評価される。
// 旧: MIRの先頭文字ホワイトリストが数値/配列リテラル始まりを弾いてリテラル出力、三項の ':' をフォーマット指定子と誤認していた
import std::io::println;

int main() {
    // D1: 先頭が数値の式
    println("{2 + 3}");
    // 先頭が文字列リテラルの式
    println("{\"hi\".len()}");
    // D3: 先頭が配列リテラルの式
    println("{[1, 2, 3].len()}");
    // 有効な変数と式の同居（旧: 全体がリテラル化）
    int x = 9;
    println("{x} {2 + 3}");

    // D2: 三項演算子の ':' はフォーマット指定子ではない
    bool c = true;
    int a = 10;
    int b = 20;
    println("{c ? a : b}");
    // 三項 + フォーマット指定子（末尾の :x のみが指定子）
    println("{c ? a : b:x}");

    // フォーマット指定子は従来どおり動作する
    int n = 255;
    println("{n:x}");
    return 0;
}
