import std::io::println;
// enum型の非網羅的matchのテスト

enum Color {
    Red = 0,
    Green = 1,
    Blue = 2
}

int main() {
    const int c = Color::Red;

    // Blueがないため非網羅的
    const string name = match (c) {
        Color::Red => "赤",
        Color::Green => "緑",
    };

    println("color = {name}");
    return 0;
}
