// derive付きジェネリック構造体のユニオン型引数特殊化は診断で拒否される
// （特殊化キーのユニオン正準エンコードとtypedef同一視が未整備のため。宣言フィールドのユニオンEqは正常動作する）
// （従来はユニオンの等価演算子が未生成のまま参照され、Undefined symbolsの難読リンク失敗だった）
import std::io::println;

typedef IU = int | string;

struct Box<T> with Eq {
    T v;
}

int main() {
    Box<IU> a = { v: 1 };
    Box<IU> b = { v: 1 };
    println("{a == b}");
    return 0;
}
