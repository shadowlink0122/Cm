// typeof(expr) - 変数から型名を文字列で取得するテスト
import std::io::println;

struct Point {
    int x;
    int y;
}

struct Pair<T> {
    T first;
    T second;
}

int main() {
    // 基本型
    int i = 42;
    const double d = 3.14;
    const bool b = true;
    const char c = 'A';

    const string ti = typeof(i);
    const string td = typeof(d);
    const string tb = typeof(b);
    const string tc = typeof(c);

    println("int: {ti}");
    println("double: {td}");
    println("bool: {tb}");
    println("char: {tc}");

    // 構造体
    const Point pt = Point{x: 10, y: 20};
    const string tpt = typeof(pt);
    println("struct: {tpt}");

    // ポインタ
    int* pi = &i;
    int** ppi = &pi;
    const string tpi = typeof(pi);
    const string tppi = typeof(ppi);
    println("pointer: {tpi}");
    println("pointer to pointer: {tppi}");

    // 配列
    int[5] arr;
    const string tarr = typeof(arr);
    println("array: {tarr}");

    // ジェネリクス構造体
    Pair<int> pair_int;
    pair_int.first = 1;
    pair_int.second = 2;
    const string tpair = typeof(pair_int);
    println("generic: {tpair}");

    return 0;
}
