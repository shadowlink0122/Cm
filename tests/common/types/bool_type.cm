// bool型のテスト
import std::io::println;

int main() {
    // bool (true/false)
    const bool t = true;
    const bool f = false;

    println("true: {t}");
    println("false: {f}");

    // 論理演算
    const bool and_result = t && f;
    const bool or_result = t || f;
    const bool not_result = !t;

    println("true && false = {and_result}");
    println("true || false = {or_result}");
    println("!true = {not_result}");

    // 比較から得られるbool
    const int a = 5;
    const int b = 10;
    const bool less = a < b;
    println("{a} < {b} = {less}");

    return 0;
}
