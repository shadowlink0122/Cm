// 変換統一ドライバ第1段の回帰: 全値消費サイト（let/単純代入/メンバ代入/return/構造体フィールド/push/引数/デフォルト引数）の
// ユニオン構築がcoerce_to_expected 1系統で挿入され、タグ+ペイロードが全経路で一致する
// 注意: 複数のユニオン関数を含むファイルでのユニオンreturnペイロードはnative/jitの既存ミスコンパイル（誤読・jsは正値）があるためタグのみ検証する（既知バグはcoercion-driver-unification.mdの実装記録を参照）
import std::io::println;

typedef IntOrStr = int | string;

struct Holder {
    IntOrStr v;
}

IntOrStr ret_union(int x) {
    return x;
}

void take_union(IntOrStr u, IntOrStr d = 77) {
    println("arg={u is int} def={d is int} defv={d as int}");
}

int main() {
    // return（上記の既知バグのためタグのみ検証）
    const IntOrStr r = ret_union(5);
    println("ret={r is int}");
    // 引数・デフォルト引数
    take_union(9 as IntOrStr);
    // let初期化
    IntOrStr a = 42;
    println("let={a is int} v={a as int}");
    // 単純代入
    a = "hello";
    println("assign={a is string} v={a as string}");
    // 構造体リテラルフィールド・メンバ代入
    Holder h = Holder{v: 1};
    println("field={h.v is int}");
    h.v = "world";
    println("member={h.v is string} v={h.v as string}");
    h.v = 7;
    println("member2={h.v is int} v={h.v as int}");
    // push（ユニオン要素スライス）
    IntOrStr[] xs = [];
    xs.push(10);
    xs.push("s");
    println("push0={xs[0] is int} push1={xs[1] is string}");
    return 0;
}
