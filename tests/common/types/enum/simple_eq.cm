// 単純enum（ペイロードなし・int表現）の == / != 回帰テスト。
// 旧: 比較のHIR書き換えが挿入する __tag メンバがMIRで未初期化のerrorテンポラリになり、変数とバリアントの比較が常に偽だった
import std::io::println;

enum Color { Red, Green, Blue }

int main() {
    const Color c = Color::Blue;

    // 文としての比較
    const bool eq = c == Color::Blue;
    println("eq: {eq}");

    // if条件
    if (c == Color::Blue) {
        println("if: match");
    }
    if (c != Color::Red) {
        println("ne: ok");
    }

    // 補間内の比較（旧: バリアントが0に解決されていた）
    println("interp: {c == Color::Blue} {c == Color::Green}");
    return 0;
}
