// mixed_int_types.cm - 様々な整数型の組み合わせテスト
import std::io::println;

int main() {
    println("=== mixed int types ===");

    // tiny + short
    const tiny a = 10;
    const short b = 100;
    const short c = a + b;
    println(c);  // 110

    // short + int
    const short d = 50;
    const int e = 1000;
    const int f = d + e;
    println(f);  // 1050

    // tiny + int (2段階の拡張)
    const tiny g = 5;
    const int h = 500;
    const int i = g + h;
    println(i);  // 505

    // 複合代入: tiny変数 += int値 (左辺への切り捨て)
    tiny j = 10;
    j += 5;      // 5はint型
    println(j);  // 15

    // 複合代入: short変数 += tiny値
    short k = 200;
    const tiny l = 50;
    k += l;
    println(k);  // 250

    // 符号なし型
    const utiny m = 200;
    const ushort n = 1000;
    const ushort o = m + n;
    println(o);  // 1200

    println("PASS");
    return 0;
}
