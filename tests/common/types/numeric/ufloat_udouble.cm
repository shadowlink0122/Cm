import std::io::println;
// ufloat/udouble型のテスト
int main() {
    // ufloat (32bit non-negative float)
    const ufloat x = 1.5;
    const ufloat y = 2.5;
    const ufloat z = x + y;

    // udouble (64bit non-negative float)
    const udouble a = 3.14159265358979;
    const udouble b = 2.71828182845904;
    const udouble c = a * b;

    // 出力
    println("{x} + {y} = {z:.1}");
    println("{a} * {b} = {c:}");

    // 型変換
    const ufloat f = 1.0;
    const udouble d = 2.0;
    const udouble result = d + f;
    // fがdoubleに昇格
    println("Result: {result:.1}");

    return 0;
}
