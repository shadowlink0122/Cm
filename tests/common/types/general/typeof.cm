import std::io::println;
// typeof演算子テスト

struct Point {
    int x;
    int y;
}

int main() {
    // 基本変数
    const int i = 42;
    const long l = 100;
    const double d = 3.14;
    const char c = 'a';
    const bool b = true;

    // typeof は sizeof と組み合わせて使用できる
    // sizeof(typeof(x)) は sizeof(x) と同じ結果を返すべき

    // 整数型
    const int si = sizeof(i);
    const int sl = sizeof(l);
    const int sd = sizeof(d);
    const int sc = sizeof(c);
    const int sb = sizeof(b);

    println("sizeof(i) = {si}");
    println("sizeof(l) = {sl}");
    println("sizeof(d) = {sd}");
    println("sizeof(c) = {sc}");
    println("sizeof(b) = {sb}");

    // 構造体
    const Point pt = Point{x: 10, y: 20};
    const int spt = sizeof(pt);
    println("sizeof(pt) = {spt}");

    // 配列
    int[5] arr;
    const int sarr = sizeof(arr);
    println("sizeof(arr) = {sarr}");

    // ポインタ
    int x = 0;
    int* pi = &x;
    const int spi = sizeof(pi);
    println("sizeof(pi) = {spi}");

    return 0;
}
