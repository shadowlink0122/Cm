// 整数型の境界値テスト
import std::io::println;

int main() {
    // ===== 符号付き整数 =====

    // tiny (8bit signed: -128 to 127)
    const tiny t_min = -128;
    const tiny t_max = 127;
    println("tiny min: {t_min}");
    println("tiny max: {t_max}");

    // short (16bit signed: -32768 to 32767)
    const short s_min = -32768;
    const short s_max = 32767;
    println("short min: {s_min}");
    println("short max: {s_max}");

    // int (32bit signed: -2147483648 to 2147483647)
    const int i_min = -2147483648;
    const int i_max = 2147483647;
    println("int min: {i_min}");
    println("int max: {i_max}");

    // ===== 符号なし整数 =====

    // utiny (8bit unsigned: 0 to 255)
    const utiny ut_min = 0;
    const utiny ut_max = 255;
    println("utiny min: {ut_min}");
    println("utiny max: {ut_max}");

    // ushort (16bit unsigned: 0 to 65535)
    const ushort us_min = 0;
    const ushort us_max = 65535;
    println("ushort min: {us_min}");
    println("ushort max: {us_max}");

    // uint (32bit unsigned: 0 to 4294967295)
    const uint ui_min = 0;
    const uint ui_max = 4294967295;
    println("uint min: {ui_min}");
    println("uint max: {ui_max}");

    return 0;
}
