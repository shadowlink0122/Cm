// ビット演算での型幅拡張テスト (bugs2#4/bugs1#2修正)
// ulong/long変数と整数リテラルの二項演算で型が正しく統一されること確認
import std::io::println;

int main() {
    // === ulong と int リテラルのビット演算 ===
    const ulong mask_val = 0xFF;
    const ulong val1 = 0x1234;
    const ulong result1 = val1 & 0xFF;
    println(result1);  // 52 (0x34)

    const ulong val2 = 0xABCD;
    const ulong result2 = val2 | 0xF000;
    println(result2);  // 0xFBCD = 64461

    const ulong val3 = 0xFF00;
    const ulong result3 = val3 ^ 0x0F0F;
    println(result3);  // 0xF00F = 61455

    // === long と int リテラルのビット演算 ===
    const long lval1 = 0x1234;
    const long lresult1 = lval1 & 0xFF;
    println(lresult1);  // 52

    // === シフト演算 ===
    const ulong shift1 = 1;
    const ulong shifted = shift1 << 16;
    println(shifted);  // 65536

    // === 複合ビット演算 ===
    const ulong bits = 0xFF00FF00;
    const ulong low_byte = bits & 0xFF;
    println(low_byte);  // 0

    const ulong mid_byte = (bits >> 8) & 0xFF;
    println(mid_byte);  // 255

    println("PASS");
    return 0;
}
