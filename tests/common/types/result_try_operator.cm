// ?演算子（Result/Optionのエラー伝播）のテスト:
// Ok/Someはペイロードを返し、Err/Noneは呼び出し元へそのまま早期returnされる
import std::io::println;

Result<int, string> divide(int a, int b) {
    if (b == 0) {
        return Result::Err("division by zero");
    }
    return Result::Ok(a / b);
}

Result<int, string> calc(int a, int b) {
    int q = divide(a, b)?;
    int q2 = divide(q, 2)?;
    return Result::Ok(q2 * 10);
}

Option<int> half(int x) {
    if (x % 2 == 0) {
        return Option::Some(x / 2);
    }
    return Option::None;
}

Option<int> quarter(int x) {
    int h = half(x)?;
    int q = half(h)?;
    return Option::Some(q);
}

int main() {
    match (calc(20, 2)) {
        Result::Ok(v) => println("calc ok: {v}"),
        Result::Err(e) => println("calc err: {e}"),
    }
    match (calc(1, 0)) {
        Result::Ok(v) => println("calc ok: {v}"),
        Result::Err(e) => println("calc err: {e}"),
    }
    match (quarter(8)) {
        Option::Some(v) => println("quarter: {v}"),
        Option::None => println("quarter: none"),
    }
    match (quarter(6)) {
        Option::Some(v) => println("quarter: {v}"),
        Option::None => println("quarter: none"),
    }
    // ?と三項演算子の共存
    int t = 1 == 1 ? 100 : 200;
    println("ternary: {t}");
    return 0;
}
