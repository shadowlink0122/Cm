// const集約グローバルの回帰（B1）: 従来はゼロ初期化のrodata定数へmainエントリのstore列で初期化され、O0はSIGBUSでクラッシュ・最適化時はstoreと読み出しの順序保証がなく誤値（ゼロ）を返していた
// 定数初期化子はLLVMのconstant initializerへ直接畳み込まれ、rodataへのstoreは発行されない
import std::io::println;

const int[3] W = [2, 4, 6];
const double[2] RATES = [1.5, 2.5];
const int[2][2] GRID = [[1, 2], [3, 4]];

struct Limits {
    int min;
    int max;
    string label;
}

const Limits L = Limits{min: -5, max: 100, label: "range"};

// 関数越しの読み出しでグローバル実体からのロードを検証する
int sum_w() {
    int total = 0;
    for (int i = 0; i < 3; i = i + 1) {
        total = total + W[i];
    }
    return total;
}

int main() {
    // 固定長配列の要素読み出し（ゼロでない値が返ることを確認）
    println(W[0]);
    println(W[2]);
    println(sum_w());

    // 浮動小数配列
    println(RATES[0]);
    println(RATES[1]);

    // 多次元配列
    println(GRID[0][1]);
    println(GRID[1][0]);

    // 構造体（負数・文字列フィールド含む）
    println(L.min);
    println(L.max);
    println(L.label);

    return 0;
}
