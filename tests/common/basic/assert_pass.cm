// std::debug::assert のテスト（成功パス）:
// 条件が真なら何も起きず実行が継続する
import std::io::println;
import std::debug::assert;

int main() {
    int x = 5;
    assert(x == 5, "x must be 5");
    assert(x > 0, "x must be positive");

    uint u = 10;
    assert(u < 100, "u must be less than 100");

    println("all asserts passed");
    return 0;
}
