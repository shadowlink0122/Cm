// unsignedセマンティクスのテスト:
// 回帰: uintの比較・除算・シフトが符号付きで実行され、
// INT_MAXを超えるuint値で結果が壊れるバグの検証。
// 関数経由で値を得ることで定数畳み込みされない実行時経路も検証する
import std::io::println;

uint big() {
    return 3000000000;
}

uint ten() {
    return 10;
}

utiny max_utiny() {
    return 255;
}

int main() {
    // 実行時経路（関数呼び出し経由）
    const uint u = big();
    if (u > 1000) {
        println("cmp: unsigned");
    } else {
        println("cmp: signed(BUG)");
    }

    const uint d = u / ten();
    println("div = {d}");

    const uint s = u >> 4;
    println("shr = {s}");

    const int widened = max_utiny() as int;
    println("utiny 255 as int = {widened}");

    // 定数畳み込み経路
    const uint cu = 3000000000;
    if (cu > 1000) {
        println("const cmp: unsigned");
    } else {
        println("const cmp: signed(BUG)");
    }
    const utiny ct = 255;
    const int cw = ct as int;
    println("const utiny 255 as int = {cw}");
    return 0;
}
