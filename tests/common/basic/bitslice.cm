// ビットスライス構文（v0.16.0）: x[hi:lo]（SV流・両端含む）と
// x[base +: width]（インデックスドパートセレクト）の読み書き。
// 全実行系バックエンドでシフト+マスク脱糖の同一結果になることを検証
import std::io::println;

int main() {
    uint word = 0xABCD;
    uint hi = (word[15:8]) as uint;
    uint lo = (word[7:0]) as uint;
    println("read: {hi} {lo}");

    uint i = 1;
    uint nib = (word[i*4 +: 4]) as uint;
    println("part: {nib}");

    word[11:4] = 0xFF;
    println("write: {word}");

    word[3:0] = 0;
    println("write2: {word}");

    // 64bit境界
    ulong wide = 0xF0F0F0F0F0F0F0F0;
    ulong mid = (wide[39:32]) as ulong;
    println("wide: {mid}");
    return 0;
}
