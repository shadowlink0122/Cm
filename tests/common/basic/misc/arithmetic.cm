// 基本的な算術演算テスト
import std::io::println;
int main() {
    const int a = 10;
    const int b = 20;

    // 加算
    const int sum = a + b;
    println(sum);

    // 減算
    const int diff = b - a;
    println(diff);

    // 乗算
    const int prod = a * 2;
    println(prod);

    // 除算
    const int quot = b / 2;
    println(quot);

    // 剰余
    const int rem = b % 3;
    println(rem);

    return 0;
}
