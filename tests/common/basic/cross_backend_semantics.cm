// バックエンド間の意味論一貫性プローブ:
// 全実行系バックエンド（interpreter/JIT/LLVM native/WASM/JS）で
// 同一出力になることを検証する。負数の剰余・除算（C意味論）、
// 算術右シフト、狭い型のキャスト往復、論理演算、文字列比較を含む。
// 回帰: JSバックエンドで補間式内の整数除算が浮動小数点のままになる
// バグ（error型がresult_typeに伝播）の検証
import std::io::println;

int neg7() { return -7; }
int three() { return 3; }
tiny minus1() { return -1; }
bool yes() { return true; }

int main() {
    // 負数の剰余・除算（C意味論: -7 % 3 == -1, -7 / 3 == -2）
    println("mod = {neg7() % three()}");
    println("div = {neg7() / three()}");

    // 符号付き算術右シフト
    println("shr = {neg7() >> 1}");

    // 狭い型のキャスト往復（tiny -1 → utiny 255 → int 255）
    tiny t = minus1();
    utiny u = t as utiny;
    int i = u as int;
    println("cast = {i}");

    // 論理演算の短絡と結合
    bool b = yes();
    if (b && !(!b)) {
        println("logic ok");
    }

    // 文字列比較
    string s1 = "abc";
    if (s1 == "abc") {
        println("streq ok");
    }

    // 比較の連鎖（bool化）
    println("cmp = {neg7() < three()}");
    return 0;
}
