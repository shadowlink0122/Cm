// グローバル変数への単純代入のテスト
// 回帰: 関数内の g = 999 が「関数内で読まれていない」という理由でデッドストア除去され、グローバルへの書き込みが消失するバグの検証
import std::io::println;

int g = 10;

void setg() {
    g = 999;
}

void setg_arg(int v) {
    g = v;
}

int main() {
    setg();
    println("{g}");
    g = 100;
    println("{g}");
    setg_arg(42);
    println("{g}");
    return 0;
}
