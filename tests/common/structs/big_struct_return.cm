import std::io::println;

// C14 Phase 4回帰: 16バイト超構造体の戻り値がsret（隠し出力ポインタ）で返り、
// 第一級集約returnのSROA展開によるO2二次爆発が起きないこと（int[16384]で実測60秒超→1秒未満）と、
// 値が正しく呼び出し元へ渡ることを検証する。小構造体（16バイト以下）は従来ABIのまま。
// 値渡し引数の検証は中型構造体で行う（大配列の値渡し引数は別問題としてbyval段で対応予定）

struct Big {
    int[16384] data;
    int tag;
}

struct Mid {
    long a;
    long b;
    long c;
    int tag;
}

struct Small {
    int x;
    int y;
}

Big make_big(int v) {
    Big b;
    b.data[0] = v;
    b.data[16383] = v + 1;
    b.tag = v * 2;
    return b;
}

Mid pass_through(Mid src) {
    src.tag = src.tag + 100;
    return src;
}

Small make_small(int v) {
    Small s;
    s.x = v;
    s.y = v * 3;
    return s;
}

int main() {
    Big b = make_big(7);
    println(b.data[0]);
    println(b.data[16383]);
    println(b.tag);

    // 中型構造体（16バイト超=sret対象）の値渡し+sret戻り（呼び出し元の値は変更されない）
    Mid m;
    m.a = 1;
    m.b = 2;
    m.c = 3;
    m.tag = 14;
    Mid m2 = pass_through(m);
    println(m2.tag);
    println(m.tag);

    // 結果を捨てる呼び出し（ダミーバッファ経路）
    make_big(1);

    // 小構造体は従来ABI
    Small s = make_small(5);
    println(s.x);
    println(s.y);
    return 0;
}
