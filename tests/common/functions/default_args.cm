// デフォルト引数の回帰テスト:
// 文としての呼び出しと文字列補間内の呼び出し（旧: 補間内は関数定義情報が
// 渡らず引数不足のままLLVMシンボル未解決でクラッシュ）の両方を検証
import std::io::println;

int greet(int a, int b = 10) { return a + b; }
int triple(int a, int b = 2, int c = 3) { return a * 100 + b * 10 + c; }

int main() {
    // 文として（HIR loweringが補完）
    const int r1 = greet(1);
    const int r2 = greet(1, 2);
    println("stmt: {r1} {r2}");

    // 補間内（MIR loweringが補完）
    println("interp: {greet(5)} {greet(5, 6)}");

    // 複数デフォルトの部分省略
    println("multi: {triple(1)} {triple(1, 9)} {triple(1, 9, 8)}");
    return 0;
}
