//! platform: !sv
// C8/C16回帰（mono-flat-name-elimination）: ユーザー定義のフラット風名前（Box__Box__int）とジェネリック特殊化Box<Box<int>>が共存できる
// （特殊化キーはユーザー定義名との衝突時に$エンコードへフォールバックし、逆算と混同しない）
import std::io::println;

struct Box__Box__int {
    int marker;
}

struct Box<T> {
    T v;
}

int main() {
    Box__Box__int u = Box__Box__int{marker: 111};
    Box<Box<int>> b = Box{v: Box{v: 42}};
    println("user={u.marker} nested={b.v.v}");
    return 0;
}
