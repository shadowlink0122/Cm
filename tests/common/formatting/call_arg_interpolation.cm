// 補間内の関数呼び出し引数のテスト
// 回帰テスト: {func(var)} の変数引数がダミーの0に化けるバグの検証
import std::io::println;

int is_big(int status) {
    if (status >= 500) {
        return 1;
    }
    return 0;
}

int add3(int a, int b, int c) {
    return a + b + c;
}

int main() {
    const int s = 503;
    const int x = 10;
    const int y = 20;

    // 変数引数の関数呼び出し補間
    println("var_arg: {is_big(s)}");

    // リテラル引数（従来から動作）
    println("lit_arg: {is_big(503)}");
    println("lit_small: {is_big(42)}");

    // 複数引数（変数とリテラルの混在）
    println("multi: {add3(x, y, 5)}");

    // 負数リテラル引数
    println("neg: {add3(-1, x, 0)}");

    return 0;
}
