import std::io::println;
// プリミティブ型へのimplテスト

interface Abs {
    int abs();
}

impl int for Abs {
    int abs() {
        if (self < 0) {
            return -self;
        }
        return self;
    }
}

int main() {
    const int a = 5;
    const int b = -3;
    const int c = 0;

    const int abs_a = a.abs();
    const int abs_b = b.abs();
    const int abs_c = c.abs();
    println("{abs_a}");
    println("{abs_b}");
    println("{abs_c}");

    return 0;
}
