import std::io::println;
// derive_generic.cm - ジェネリック構造体への#[derive]（モノモーフィゼーション経由）

interface Eq<T> {
    operator bool ==(T other);
}

#[derive(Eq)]
struct Pair<T, U> {
    T first;
    U second;
}

int main() {
    Pair<int, string> p1;
    p1.first = 1;
    p1.second = "one";

    Pair<int, string> p2;
    p2.first = 1;
    p2.second = "one";

    Pair<int, string> p3;
    p3.first = 2;
    p3.second = "one";

    if (p1 == p2) {
        println("p1 == p2: true");
    } else {
        println("p1 == p2: false");
    }

    if (p1 == p3) {
        println("p1 == p3: true");
    } else {
        println("p1 == p3: false");
    }

    return 0;
}
