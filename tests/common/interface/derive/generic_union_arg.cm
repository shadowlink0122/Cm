// derive付きジェネリック構造体のユニオン型引数特殊化: ユニオン==（タグ+ペイロード比較）で正常動作する
// （derive単一ソース化で診断から正常系へ昇格）
// （従来はユニオンの等価演算子が未生成のまま参照され、Undefined symbolsの難読リンク失敗だった）
import std::io::println;

typedef IU = int | string;

struct Box<T> with Eq {
    T v;
}

int main() {
    Box<IU> a = { v: 1 };
    Box<IU> b = { v: 1 };
    println("{a == b}");
    return 0;
}
