// derive付きジェネリック構造体のスライス型引数特殊化: スライス==が内容比較のため正常動作する
// （derive単一ソース化で診断から正常系へ昇格。従来は生バイナリ比較の無言誤値→診断→内容比較の順に是正）
import std::io::println;

struct Box<T> with Eq {
    T v;
}

int main() {
    Box<int[]> a = { v: [1, 2, 3] };
    Box<int[]> b = { v: [1, 2, 3] };
    println("{a == b}");
    return 0;
}
