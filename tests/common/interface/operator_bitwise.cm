import std::io::println;

// ビット演算子オーバーロードテスト
struct Num {
    int value;
}

impl Num {
    operator Num &(Num other) {
        return Num{value: self.value & other.value};
    }

    operator Num | (Num other) {
        return Num{value: self.value | other.value};
    }

    operator Num ^(Num other) {
        return Num{value: self.value ^ other.value};
    }

    operator Num <<(Num other) {
        return Num{value: self.value << other.value};
    }

    operator Num >>(Num other) {
        return Num{value: self.value >> other.value};
    }
}

int main() {
    const Num m = Num{value: 0xFF};
    const Num n = Num{value: 0x0F};

    const Num band = m & n;
    println("0xFF & 0x0F = {band.value}");

    const Num bor = m | n;
    println("0xFF | 0x0F = {bor.value}");

    const Num bxor = m ^ n;
    println("0xFF ^ 0x0F = {bxor.value}");

    const Num shl = Num{value: 1} << Num{value: 4};
    println("1 << 4 = {shl.value}");

    const Num shr = Num{value: 32} >> Num{value: 2};
    println("32 >> 2 = {shr.value}");

    return 0;
}
