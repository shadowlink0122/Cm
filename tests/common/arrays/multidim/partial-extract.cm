import std::io::println;
// 多次元配列・スライスの低次元部分取り出しの回帰。
// 型宣言のサフィックスは左から積む: int[2][3] は「int[2] が3個」で、m[i] は int[2] を返す

struct Point { int x; int y; }

int sum3(int[3] xs) {
    return xs[0] + xs[1] + xs[2];
}

int[3] pick_row(int[3][3] m, int i) {
    return m[i];
}

int main() {
    // 正方2次元: 行の取り出し・auto推論・値セマンティクス（コピー）
    int[3][3] a;
    a[1][0] = 1;
    a[1][1] = 2;
    a[1][2] = 3;
    int[3] b = a[1];
    b[0] = 99;
    println("copy: {a[1][0]} {b[0]}");
    auto ab = a[1];
    println("auto2d: {ab[2]}");

    // 3次元 → 1次元 / 2次元
    int[3][3][3] c;
    c[2][1][0] = 210;
    c[2][1][2] = 212;
    int[3] c1 = c[2][1];
    int[3][3] c2 = c[2];
    auto c3 = c[2][1];
    println("cube: {c1[0]} {c2[1][2]} {c3[2]}");

    // 非正方（int[2][3] = int[2]が3個）
    int[2][3] ns;
    ns[2][1] = 9;
    int[2] nsr = ns[2];
    println("nonsq: {nsr[1]}");

    // 8バイト要素の非正方
    double[3][2] dm;
    dm[1][2] = 2.5;
    double[3] drow = dm[1];
    long[3][2] lm;
    lm[1][2] = 77;
    auto lrow = lm[1];
    println("wide: {drow[2]} {lrow[2]}");

    // 関数境界
    println("fn: {sum3(a[1])} {pick_row(a, 1)[2]}");

    // ユーザー定義型の多次元宣言と部分取り出し
    Point[2][2] grid;
    grid[1][0].x = 7;
    Point[2] prow = grid[1];
    println("struct: {prow[0].x}");

    // string要素
    string[2][2] names;
    names[1][0] = "alice";
    string[2] pair = names[1];
    println("str: {pair[0]}");

    // スライスofスライスの部分取り出し
    int[][] rows;
    int[] inner;
    inner.push(5);
    inner.push(6);
    rows.push(inner);
    int[] got = rows[0];
    auto got2 = rows[0];
    println("sos: {got[0]} {got2[1]}");

    // スライスof固定長配列の要素コピー
    int[2][] cells;
    int[2] cell;
    cell[0] = 70;
    cell[1] = 80;
    cells.push(cell);
    int[2] e = cells[0];
    auto e2 = cells[0];
    println("soa: {e[0]} {e2[1]}");
    return 0;
}
