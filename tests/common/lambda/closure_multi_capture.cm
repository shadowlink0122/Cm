import std::io::println;

// 複数変数をキャプチャするクロージャのテスト
int main() {
    const int a = 10;
    const int b = 20;

    // 2つの外部変数をキャプチャ
    const int*(int) adder = (int x) => { return x + a + b;
    };

    const int result = adder(5);
    // 5 + 10 + 20 = 35
    println("result: {result}");

    return 0;
}
