#[input] posedge clk;
#[input] bool req;
#[output] bool ack = false;

bool s1 = false;

async void pipeline(posedge clk) {
    ack = s1;
    s1 = req;
}

#[test]
void check_props() {
    sv_assert_property(clk, implies(req, after(ack, 2)));
    sv_assert_property(clk, implies(rose(req), ack));
    sv_assert_property(clk, implies_next(req, stable(ack)));
    req = true;
    step(4);
}
