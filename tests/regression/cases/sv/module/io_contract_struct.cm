#[input] bool clk = false;

module io_contract_top;

// IO契約構造体（#[input]/#[output]フィールド）はデータ型ではないため
// typedef struct packed として出力されない
export struct io_contract_top {
    #[input] uint a;
    #[output] uint result;
}

#[input] uint a;
#[output] uint result = 0;

void tick(posedge clk) {
    result = a;
}
