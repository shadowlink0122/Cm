//! platform: sv

// #[test] 関数のassertがx安全な比較（!== 1'b1）で生成されることの回帰（R15）
import std::debug::assert;

#[input] posedge clk;
#[input] uint din;
#[output] uint dout = 0;

async void ff(posedge clk) {
    dout = din;
}

#[test]
void latch_value() {
    din = 9;
    step(1);
    assert(dout == 9, "value latched");
}
