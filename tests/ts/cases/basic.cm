//! platform: js
// 基本: 関数の引数・戻り値・ローカルの型注釈
int add(int a, int b) {
    return a + b;
}
double half(double x) {
    return x / 2.0;
}
bool is_even(int n) {
    return n % 2 == 0;
}
int main() {
    int s = add(3, 4);
    double h = half(10.0);
    bool e = is_even(s);
    println("s={s} h={h} e={e}");
    return 0;
}
