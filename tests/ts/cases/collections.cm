//! platform: js
// 配列とループ
int sum_array(int[5] arr) {
    int total = 0;
    for (int i = 0; i < 5; i++) {
        total = total + arr[i];
    }
    return total;
}
int main() {
    int[5] nums;
    for (int i = 0; i < 5; i++) {
        nums[i] = i * 2;
    }
    println("sum={sum_array(nums)}");
    return 0;
}
