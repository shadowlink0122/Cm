//! platform: sv
//! test: din=5, cycles=2 -> dout=5

// パラメタライズドサブモジュール（#[sv::parameter] + IOインスタンス）
#[sv::parameter] const uint WIDTH = 8;

#[input] posedge clk;

struct ParamShifterIo {
    #[input] bit[WIDTH] din;
    #[output] bit[WIDTH] dout = 0;
};

ParamShifterIo io;

async void shift(posedge clk) {
    io.dout = io.din;
}
