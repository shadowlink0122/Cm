//! platform: sv

// 階層化テスト用のALUサブモジュール（hier_top.cm からインスタンス化される）
// op: 0=加算, 1=減算, 2=AND, その他=OR
//
// IOはC/C++スタイルの構造体宣言とそのインスタンスで定義する。
// フィールドがそのままモジュールポートへ展開されるため、個別のポート宣言は不要

struct hier_alu_io {
    #[input] uint a;
    #[input] uint b;
    #[input] utiny op;
    #[output] uint result;
};

hier_alu_io io;

void alu_comb() {
    if (io.op == 0) {
        io.result = io.a + io.b;
    } else if (io.op == 1) {
        io.result = io.a - io.b;
    } else if (io.op == 2) {
        io.result = io.a & io.b;
    } else {
        io.result = io.a | io.b;
    }
}
