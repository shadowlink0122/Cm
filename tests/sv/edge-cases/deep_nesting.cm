//! platform: sv
//! description: Deep nesting test for SV codegen

#[input] bool clk = false;
#[input] uint sel = 0;
#[output] uint result = 0;

async void deep_nested(posedge clk) {
    if (sel == 0) {
        if (result == 0) {
            if (clk == true) {
                result = 1;
            } else {
                result = 2;
            }
        } else {
            if (result == 1) {
                result = 3;
            } else {
                result = 4;
            }
        }
    } else {
        if (sel == 1) {
            result = 10;
        } else {
            if (sel == 2) {
                result = 20;
            } else {
                result = 30;
            }
        }
    }
}
