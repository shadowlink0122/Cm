//! platform: sv

// #[sv::param] テスト: parameter宣言の生成確認

#[sv::param] const uint WIDTH = 8;
#[sv::param] const uint DEPTH = 256;

#[input]  bool clk = 0;
#[input]  bool we = 0;
#[input]  uint addr = 0;
#[input]  uint wdata = 0;
#[output] uint rdata = 0;

always void read_proc(posedge clk) {
    if (we) {
        rdata = wdata;
    }
}
