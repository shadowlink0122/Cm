//! platform: sv

// ネスト型定義のSV変換: ネストstruct/enumは::を__へ写像した一意名（Pack__Pair・Ctrl__St）のtypedefとして出力される

struct Pack {
    struct Pair {
        int lo;
        int hi;
    };
    Pair p;
};

enum Ctrl {
    enum St {
        IDLE,
        RUN,
    },
    NOP,
}

#[input]  int a = 0;
#[output] int y = 0;

void step() {
    Pack k;
    k.p.lo = a;
    k.p.hi = 2;
    y = k.p.lo + k.p.hi + (Ctrl::St::RUN as int);
}
