//! platform: sv

// C/C++スタイル宣言子（匿名structメンバ）のSV変換: ::を__へ写像した一意名（Pack____anon_p）のtypedefとして出力される

struct Pack {
    struct {
        int lo;
        int hi;
    } p;
};

#[input]  int a = 0;
#[output] int y = 0;

void step() {
    Pack k;
    k.p.lo = a;
    k.p.hi = 2;
    y = k.p.lo + k.p.hi;
}
