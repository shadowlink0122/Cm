//! platform: sv
//! test: cycles=1 -> out=42

// レジスタ宣言初期値の回帰テスト:
// モジュールレベル変数の初期値（= 42）は宣言初期値として出力される必要がある。
// 出力されないとシミュレーションで X のままとなり、FSMや counter がいつまでも動き出さない（Gowin等のFPGA実機でのみ動く状態になる）。

#[input] posedge clk;
#[output] uint out = 0;

uint counter = 42;

async void tick() {
    out = counter;
    counter = counter + 1;
}
