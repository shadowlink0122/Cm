//! platform: sv
//! test: data=255, sel=0 -> out=170
//! test: data=255, sel=1 -> out=85

// 2進数ビットパターン操作テスト
// ビットマスク・反転・シフトを2進数リテラルで検証

#[input]  utiny data = 0;
#[input]  bool sel = false;
#[output] utiny out = 0;

void bit_ops() {
    if (sel) {
        // 奇数ビットマスク: 0b01010101 = 0x55 = 85
        out = data & 0b01010101;
    } else {
        // 偶数ビットマスク: 0b10101010 = 0xAA = 170
        out = data & 0b10101010;
    }
}
