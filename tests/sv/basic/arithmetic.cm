//! platform: sv
//! test: a=10, b=3 -> sum=13, diff=7, prod=30, quot=3, rem=1

// 算術演算の網羅テスト: +, -, *, /, %

#[input]  int a = 0;
#[input]  int b = 0;
#[output] int sum = 0;
#[output] int diff = 0;
#[output] int prod = 0;
#[output] int quot = 0;
#[output] int rem = 0;

void calc() {
    sum = a + b;
    diff = a - b;
    prod = a * b;
    quot = a / b;
    rem = a % b;
}
