//! platform: sv
//! test: write_enable=1, addr=0, write_data=42, cycles=2 -> read_data=42

// BRAM推論テスト

#[input] bool clk = 0;
#[input] utiny addr = 0;
#[input] utiny write_data = 0;
#[input] bool write_enable = 0;
#[output] utiny read_data = 0;

async func tick() {
    if (write_enable) {
        read_data = write_data;
    }
}
