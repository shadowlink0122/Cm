//! platform: sv
//! test: idx=0, cycles=2 -> out=10
//! test: idx=2, cycles=2 -> out=30
//! test: idx=3, cycles=2 -> out=40

// 配列リテラル初期値のテスト:
// モジュールレベル配列の初期値は initial ブロックとして出力され、
// シミュレーション時刻0に初期化される（合成ではROM/RAM初期値）。
// 以前は初期値がサイレントに捨てられていた。

#[input] posedge clk;
#[input] uint idx;
#[output] utiny out = 0;

utiny[4] rom = [10, 20, 30, 40];

async void read(posedge clk) {
    if (idx < 4) {
        out = rom[idx];
    }
}
