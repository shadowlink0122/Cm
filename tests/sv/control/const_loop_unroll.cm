//! platform: sv
//! test: din=15, cycles=2 -> out=10

// 定数トリップカウントループの静的展開テスト（generate/genvar相当）:
// 初期値・境界・増分が定数の for ループは MIR レベルで直列展開され、
// 生成SVに while ループが残らない（合成ツールが展開できない動的whileを回避）。
// din=15 のとき out = 15 ^ (15>>1) ^ (15>>2) ^ (15>>3) = 15^7^3^1 = 10

#[input] posedge clk;
#[input] uint din;
#[output] uint out = 0;

async void update(posedge clk) {
    uint acc = 0;
    for (uint i = 0; i < 4; i = i + 1) {
        acc = acc ^ (din >> i);
    }
    out = acc;
}
