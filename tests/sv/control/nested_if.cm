//! platform: sv
//! test: a=5, b=3, c=1 -> out=5
//! test: a=1, b=7, c=1 -> out=7
//! test: a=1, b=2, c=10 -> out=10
//! test: a=1, b=2, c=3 -> out=3

// ネストif-elseの網羅テスト

#[input]  int a = 0;
#[input]  int b = 0;
#[input]  int c = 0;
#[output] int out = 0;

void nested_if() {
    if (a > b) {
        out = a;
    } else if (b > c) {
        out = b;
    } else {
        out = c;
    }
}
