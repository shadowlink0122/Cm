//! platform: sv
// 複数の #[test] 関数が宣言順に同一initialブロックで逐次実行されることを検証
import std::debug::assert;
import std::io::println;

#[input] posedge clk;
#[input] uint din;
#[output] uint dout = 0;

async void ff(posedge clk) {
    dout = din;
}

#[test]
void first_value() {
    din = 5;
    step(1);
    assert(dout == 5, "first value latched");
}

#[test]
void second_value() {
    din = 7;
    step(2);
    assert(dout == 7, "second value latched");
    println("all tests done");
}
