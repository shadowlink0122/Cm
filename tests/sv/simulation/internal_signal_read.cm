//! platform: sv
import std::debug::assert;

// #[test] からDUT内部信号（ポート以外のモジュールレベル信号）を
// dut. 階層参照で読み取れることを検証する

#[input] posedge clk;
#[output] bool led = false;

// 内部レジスタ（ポートではない）
uint counter = 0;
bool internal_flag = false;

void tick(posedge clk) {
    counter = counter + 1;
    internal_flag = counter > 3;
    led = internal_flag;
}

#[test]
void tb() {
    step(2);
    assert(!internal_flag, "internal flag not yet set");
    step(4);
    assert(internal_flag, "internal flag readable via hierarchy");
    assert(counter > 4, "internal counter readable via hierarchy");
    assert(led, "output port follows internal flag");
}
