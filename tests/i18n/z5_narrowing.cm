// i18n E2Eテスト用: Z5の縮小/符号変化の暗黙変換診断を検証するプログラム
// checkでは警告のまま、check --strictではエラーになる。適合リテラルとuint→int読み出しは無診断
int main() {
    long lv = 5000000001;
    int narrowed = lv;
    double dv = 2.9;
    float f = dv;
    int iv = -1;
    uint u = iv;
    short fits = 5;
    int[] arr;
    int len = arr.len();
    return narrowed + fits + len + (f as int) + (u as int);
}
