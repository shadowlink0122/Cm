// 代数的恒等式の簡約対象を網羅するケース
// （x*1, 1*x, x+0, 0+x, x-0, x/1, x%1, x*0, x>>0, x<<0, x|0, x^0, x&0）
int f(int a) {
    int m1 = a * 1;
    int m2 = 1 * a;
    int a1 = a + 0;
    int a2 = 0 + a;
    int s1 = a - 0;
    int d1 = a / 1;
    int r1 = a % 1;
    int z1 = a * 0;
    int sh1 = a >> 0;
    int sh2 = a << 0;
    int b1 = a | 0;
    int b2 = a ^ 0;
    int b3 = a & 0;
    return m1 + m2 + a1 + a2 + s1 + d1 + r1 + z1 + sh1 + sh2 + b1 + b2 + b3;
}
