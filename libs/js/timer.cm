// js::timer - タイマーAPI
// Node.js / ブラウザ環境のタイマー機能を提供
module js.timer;

// ============================================================
// 制限事項（R23）
// ============================================================
// setTimeout/setInterval等のコールバックAPIは、FFI宣言でコールバックを関数型として
// 渡す言語サポートが未実装のため提供していない（従来のint型宣言は実関数を渡す手段がなく、
// 数値を渡すとNode.jsのTypeError（ERR_INVALID_ARG_TYPE）で未捕捉クラッシュする死んだAPIだった）。
// 遅延実行はasync/await（js/tsターゲットで動作）を使用する。
// FFIコールバックの関数型宣言サポートは将来課題。

// ============================================================
// ラッパー関数
// ============================================================

/// 指定ミリ秒間処理をブロック（同期的なスリープ）
/// 注意: JavaScriptには同期sleepがないため、この関数は警告を出すのみ（async/awaitを使用すること）
export void sleep_ms(int ms) {
    println("警告: sleep_ms()はJSでは非推奨です。async/awaitを使用してください。");
}
