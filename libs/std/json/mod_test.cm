// std::json の単体テスト（テスト対象と同じディレクトリに置く）。
// #[test] 属性の付いた関数を `cm test` が実行する。ランナーは tests/libs/run.sh。

import std::debug::assert;
import std::json::*;

#[test]
void parses_scalars() {
    int t = json_parse("true");
    assert(t >= 0, "true parses");
    assert(json_kind(t) == JsonKind::Bool, "true is bool");
    assert(json_bool(t), "true value");

    int n = json_parse("null");
    assert(json_is_null(n), "null value");

    int num = json_parse("-12.5");
    assert(json_kind(num) == JsonKind::Number, "number kind");
    assert(json_number(num) == -12.5, "number value");

    int s = json_parse("\"hi\\nthere\"");
    assert(json_string(s) == "hi\nthere", "string with escape");
}

#[test]
void parses_array() {
    int a = json_parse("[10, 20, 30]");
    assert(json_kind(a) == JsonKind::Array, "array kind");
    assert(json_array_len(a) == 3, "array length");
    assert(json_int(json_array_get(a, 0)) == 10, "elem 0");
    assert(json_int(json_array_get(a, 2)) == 30, "elem 2");
    assert(json_array_get(a, 3) < 0, "out of range");
}

#[test]
void parses_object() {
    int o = json_parse("{\"name\":\"Cm\",\"age\":3}");
    assert(json_kind(o) == JsonKind::Object, "object kind");
    assert(json_object_has(o, "name"), "has name");
    assert(json_string(json_object_get(o, "name")) == "Cm", "name value");
    assert(json_int(json_object_get(o, "age")) == 3, "age value");
    assert(json_object_get(o, "missing") < 0, "missing key");
}

#[test]
void parses_nested() {
    int root = json_parse("{\"items\":[{\"id\":1},{\"id\":2}],\"ok\":true}");
    int items = json_object_get(root, "items");
    assert(json_array_len(items) == 2, "two items");
    int first = json_array_get(items, 0);
    assert(json_int(json_object_get(first, "id")) == 1, "first id");
    int second = json_array_get(items, 1);
    assert(json_int(json_object_get(second, "id")) == 2, "second id");
    assert(json_bool(json_object_get(root, "ok")), "ok flag");
}

#[test]
void reports_error_on_malformed() {
    assert(json_parse("{bad") < 0, "unterminated object");
    assert(json_parse("[1,2") < 0, "unterminated array");
    assert(json_parse("nul") < 0, "bad literal");
}

#[test]
void stringify_roundtrips() {
    string input = "{\"a\":[1,2],\"b\":\"x\",\"c\":true,\"d\":null}";
    int root = json_parse(input);
    assert(json_stringify(root) == input, "stringify roundtrip");
}

#[test]
void ignores_surrounding_whitespace() {
    int a = json_parse("  [ 1 , 2 ]  ");
    assert(json_array_len(a) == 2, "whitespace tolerant");
}

// R1バグ1回帰: 旧固定容量1024の境界で無限ループしない（アリーナはpushで自動拡張）
#[test]
void grows_arena_beyond_1024_nodes() {
    string big = "[";
    int i = 0;
    while (i < 1500) {
        if (i > 0) {
            big = big + ",";
        }
        big = big + "1";
        i = i + 1;
    }
    big = big + "]";
    int root = json_parse(big);
    assert(root >= 0, "1500 elements parse");
    assert(json_array_len(root) == 1500, "1500 elements counted");
    assert(json_int(json_array_get(root, 1499)) == 1, "last element readable");
}

// R1バグ2回帰: 甘い受理の拒否（末尾ゴミ・複数値・数字なしマイナス）
#[test]
void rejects_lenient_inputs() {
    assert(json_parse("-") < 0, "lone minus rejected");
    assert(json_parse("-x") < 0, "minus without digits rejected");
    assert(json_parse("{\"a\":1}xyz") < 0, "trailing garbage rejected");
    assert(json_parse("1 2") < 0, "multiple values rejected");
    assert(json_number(json_parse("-5")) == -5.0, "valid negative still parses");
    assert(json_number(json_parse("-0.5")) == -0.5, "negative fraction still parses");
}

// R1バグ3回帰: \uXXXXの実デコード（UTF-8格納・サロゲートペア）と不正エスケープの診断
#[test]
void decodes_unicode_escapes() {
    assert(json_string(json_parse("\"\\u0041BC\"")) == "ABC", "BMP ascii decode");
    assert(json_string(json_parse("\"\\u3042\"")) == "あ", "BMP 3-byte decode");
    assert(json_string(json_parse("\"\\uD83D\\uDE00\"")) == "😀", "surrogate pair decode");
    assert(json_parse("\"\\x\"") < 0, "unknown escape rejected");
    assert(json_parse("\"\\uD800\"") < 0, "lone high surrogate rejected");
    assert(json_parse("\"\\uDC00\"") < 0, "lone low surrogate rejected");
    assert(json_parse("\"\\u12G4\"") < 0, "invalid hex rejected");
    assert(json_parse("\"\\u12\"") < 0, "short hex rejected");
}

// R2回帰: 非ASCII生文字列のパース・キー参照・ラウンドトリップ（len()/charAt()の単位分裂で従来native/jit/wasmは-1で全滅していた）
#[test]
void parses_non_ascii_strings() {
    assert(json_string(json_parse("\"日本語\"")) == "日本語", "raw non-ascii string");
    assert(
        json_string(json_parse("\"改行\\nと\\\"引用\\\"と日本語\""))
        == "改行\nと\"引用\"と日本語",
        "escapes mixed with non-ascii"
    );
    const int root = json_parse("{\"名前\":\"Cm言語\",\"tags\":[\"日本語\",\"emoji😀\"]}");
    assert(root >= 0, "non-ascii object parses");
    assert(json_string(json_object_get(root, "名前")) == "Cm言語", "non-ascii key lookup");
    assert(
        json_string(json_array_get(json_object_get(root, "tags"), 1)) == "emoji😀",
        "astral element"
    );
    const string text = json_stringify(root);
    const int again = json_parse(text);
    assert(json_string(json_object_get(again, "名前")) == "Cm言語", "non-ascii roundtrip");
}
