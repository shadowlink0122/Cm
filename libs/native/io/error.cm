// std::io::error - I/Oエラー型定義
// v0.13.0
module native.io.error;

// ============================================================
// IoErrorKind - エラー種別
// ============================================================

/// I/Oエラーの種類を表すenum
export enum IoErrorKind {
    /// ファイルまたはリソースが見つからない
    NotFound,
    /// アクセス権限がない
    PermissionDenied,
    /// リソースが既に存在する
    AlreadyExists,
    /// 操作がブロックされる（非同期）
    WouldBlock,
    /// 無効な入力パラメータ
    InvalidInput,
    /// データが無効または破損
    InvalidData,
    /// タイムアウト
    TimedOut,
    /// 予期しないファイル終端
    UnexpectedEof,
    /// その他のエラー
    Other
}

// ============================================================
// IoError - エラー構造体
// ============================================================

/// I/Oエラーを表す構造体
export struct IoError {
    IoErrorKind kind;
    string message;
}

impl IoError {
    /// 新しいIoErrorを作成
    static IoError new(IoErrorKind kind, string message) {
        IoError err;
        err.kind = kind;
        err.message = message;
        return err;
    }

    /// NotFoundエラーを作成
    static IoError not_found(string path) {
        return IoError::new(IoErrorKind::NotFound, "file not found: " + path);
    }

    /// PermissionDeniedエラーを作成
    static IoError permission_denied(string path) {
        return IoError::new(IoErrorKind::PermissionDenied, "permission denied: " + path);
    }

    /// InvalidInputエラーを作成
    static IoError invalid_input(string msg) {
        return IoError::new(IoErrorKind::InvalidInput, msg);
    }

    /// その他のエラーを作成
    static IoError other(string msg) {
        return IoError::new(IoErrorKind::Other, msg);
    }

    /// エラーを文字列に変換
    string to_string() {
        return self.message;
    }

    /// エラー種別を取得
    IoErrorKind get_kind() {
        return self.kind;
    }
}

// ============================================================
// Result型（std::coreから再エクスポートするか、ここで定義）
// ============================================================

/// I/O操作の結果型
export enum IoResult<T> {
    Ok(T),
    Err(IoError)
}

// 注: IoResult<T>のis_ok/unwrap等のメソッド提供は、ジェネリックenumのimplメソッドが
// 言語未対応（特殊化メソッド本体のモノモーフ化が未実装）のため見送り。
// 呼び出し側は match (r) { IoResult::Ok(v) => {...} IoResult::Err(e) => {...} } で分岐する（R22）
