// データ層: タスクをメモリ上に保持するインメモリストア（純粋なCm、FFIなし）。
// 以前は use "pg" のFFIとvendor/pg/index.jsが必要だったが、外部JSに頼らずCmだけで状態を管理する。
// モジュールレベルのグローバル変数でリクエストを跨いで状態を保持する。

module store;

import ./models::{Task};

// 固定容量の配列＋件数でストアを表す。グローバル構造体はどのバックエンドでも保持される。
struct Store {
    Task[32] items;
    int count;
    int next_id;
}

// グローバルなストア本体。初期値はinit_store()で明示的に設定する。
Store db = { count: 0, next_id: 0 };

// ストアを初期化してseedデータを投入する（サーバ起動時に一度だけ呼ぶ）。
export void init_store() {
    db.count = 0;
    db.next_id = 1;
    add_task("Write the Cm tutorial");
    add_task("Ship v0.17.0");
    add_task("Review pull requests");
}

// タスクを1件追加する。
export void add_task(string title) {
    if (db.count >= 32) {
        return;
    }
    db.items[db.count] = { id: db.next_id, title: title, done: false };
    db.count = db.count + 1;
    db.next_id = db.next_id + 1;
}

// 未完了の先頭タスクを完了に切り替える（「次のタスクを完了」アクション用）。
export void complete_next() {
    int i = 0;
    while (i < db.count) {
        if (!db.items[i].done) {
            db.items[i].done = true;
            return;
        }
        i = i + 1;
    }
}

// 保持しているタスク数。
export int task_count() {
    return db.count;
}

// i番目のタスクを返す（値コピー）。
export Task task_at(int i) {
    return db.items[i];
}
