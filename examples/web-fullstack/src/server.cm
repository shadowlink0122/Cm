//! platform: ts
// サーバ層: Nodeの組み込み http モジュールだけでHTTPサーバを立てる（vendorも外部JSも不要）。
// require("http") はNode標準なのでvendor/を用意する必要がなく、cmだけで完結する。
// メソッド/URLの分岐・状態更新・HTML生成はすべてCmが行い、httpはソケットの受け口だけを担う。
// 依存は view 一本（view がストア/スタイル/HTMLビルダーを束ねるファサード）。
//
// 実行:
//   cm compile --target=js src/server.cm -o server.js && node server.js
//   （その後 http://localhost:8137/ をブラウザ/curlで開く）

import ./view::{page, app_init, app_add, app_complete, app_styles};

// ---- Node http モジュールのFFIシェイプ（構造体で型付けする） ----
// req.method / req.url は文字列プロパティ、res.* は関数型フィールド（JSメソッド）。
struct Req {
    string method;
    string url;
}
struct Res {
    int statusCode;
    void*(string, string) setHeader;
    void*(string) end;
}
struct Server {
    void*(int) listen;
}

use "http" {
    Server createServer(void*(Req, Res) handler);
}

// 1リクエストを処理する。ルーティングと状態更新はCmが行う。
void handle(Req req, Res res) {
    string url = req.url;

    // スタイルシート（Cmのwith Cssが生成）
    if (url == "/styles.css") {
        res.statusCode = 200;
        res.setHeader("Content-Type", "text/css; charset=utf-8");
        res.end(app_styles());
        return;
    }

    // 状態を変えるアクション（GETで扱えるようにしてブラウザから試せるようにする）
    if (url == "/add") {
        app_add();
    } else if (url == "/toggle") {
        app_complete();
    }

    // それ以外は一覧ページをSSRで返す
    res.statusCode = 200;
    res.setHeader("Content-Type", "text/html; charset=utf-8");
    res.end(page());
}

int main() {
    app_init();
    Server server = createServer(handle);
    server.listen(8137);
    println("Cm web server listening on http://localhost:8137");
    return 0;
}
